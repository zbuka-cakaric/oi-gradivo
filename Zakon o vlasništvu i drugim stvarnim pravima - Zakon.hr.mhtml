<a target=3D"_blank" rel=3D"noopener noreferrer" href=3D"https://www.zakon.=
hr/cms.htm?id=3D23591" class=3D"parsedCmsBlockLink"><strong>Rje=C5=A1enje</=
strong></a><strong>, </strong><a target=3D"_blank" rel=3D"noopener noreferr=
er" href=3D"https://www.zakon.hr/cms.htm?id=3D23753" class=3D"parsedCmsBloc=
kLink"><strong>Presuda</strong></a><strong>, </strong><a target=3D"_blank" =
